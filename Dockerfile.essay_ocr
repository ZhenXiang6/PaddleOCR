# Dockerfile for PaddleOCR 3.3.0 Essay OCR System
# Linux x86_64 环境，完整相容性
FROM python:3.10-slim

# 设置工作目录
WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y \
    libgomp1 \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgl1 \
    poppler-utils \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
RUN pip install --no-cache-dir \
    paddlepaddle==3.2.0 \
    paddleocr==3.3.0 \
    pdf2image==1.17.0 \
    tqdm \
    opencv-python==4.10.0.84 \
    numpy

# 创建输出目录
RUN mkdir -p /app/output /app/data

# 挂载点
VOLUME ["/app/data", "/app/output"]

# 默认命令
CMD ["python3"]
